    {
      "parameters": {
        "jsCode": "// Get raw LLM output\nlet text = $json.text || $json.output || $json.message || \"\";\n\n// Clean markdown fences\ntext = text.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\n// Safe parse\nlet data = {};\ntry {\n  data = JSON.parse(text);\n} catch (e) {\n  data = {};\n}\n\n// Ensure it's a plain object\nif (typeof data !== \"object\" || Array.isArray(data)) {\n  data = {};\n}\n\n// Normalize score\nlet score = Number(data.risk_score) || 0;\n\n// keyword boost logic\nconst lowerText = text.toLowerCase();\n\nif (\n  lowerText.includes(\"click\") ||\n  lowerText.includes(\"win\") ||\n  lowerText.includes(\"₹\")\n) {\n  score += 20;\n}\n\n// Risk logic\nlet level = \"LOW\";\nlet action = \"ALLOW\";\nif (score > 70) {\n  level = \"HIGH\";\n  action = \"BLOCK\";\n} else if (score > 30) {\n  level = \"MEDIUM\";\n  action = \"WARN\";\n}\n\n// Write back\ndata.risk_score = score;\ndata.risk_level = level;\ndata.action = action;\ndata.reasons = Array.isArray(data.reasons) ? data.reasons : [\"No reason provided\"];\ndata.advice = data.advice || \"Be cautious\";\n\nreturn [{ json: data }];"
      },
